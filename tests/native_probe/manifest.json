{
  "manifest_version": 3,
  "name": "Context Capsule Native Messaging Probe",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox@contextcapsule.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  }
}
